{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "paths": {
      "/generated/validators.mjs": ["./web/types/generated-validators.d.ts"],
      "*/generated/validators.mjs": ["./web/types/generated-validators.d.ts"],
      "/src/wire.mjs": ["./web/src/wire.mjs"],
      "*/src/wire.mjs": ["./web/src/wire.mjs"],
      "/src/pretty.mjs": ["./web/src/pretty.mjs"],
      "*/src/pretty.mjs": ["./web/src/pretty.mjs"],
      "/src/lineformat.mjs": ["./web/src/lineformat.mjs"],
      "*/src/lineformat.mjs": ["./web/src/lineformat.mjs"],
      "/src/wasm-validators.mjs": ["./web/src/wasm-validators.mjs"],
      "*/src/wasm-validators.mjs": ["./web/src/wasm-validators.mjs"],
      "/src/history.mjs": ["./web/src/history.mjs"],
      "*/src/history.mjs": ["./web/src/history.mjs"],
      "/src/console-bus.mjs": ["./web/src/console-bus.mjs"],
      "*/src/console-bus.mjs": ["./web/src/console-bus.mjs"],
      "/assets/pretty-json.js": ["./web/types/pretty-json-glue.d.ts"],
      "*/assets/pretty-json.js": ["./web/types/pretty-json-glue.d.ts"],
      "/assets/lineformat.js": ["./web/types/lineformat-glue.d.ts"],
      "*/assets/lineformat.js": ["./web/types/lineformat-glue.d.ts"],
      "/assets/validators.js": ["./web/types/validators-glue.d.ts"],
      "*/assets/validators.js": ["./web/types/validators-glue.d.ts"],
      "/src/components/agt-app.js": ["./web/src/components/agt-app.js"],
      "*/src/components/agt-app.js": ["./web/src/components/agt-app.js"],
      "/src/components/agt-console-app.js": ["./web/src/components/agt-console-app.js"],
      "*/src/components/agt-console-app.js": ["./web/src/components/agt-console-app.js"],
      "/src/components/agt-console-line.js": ["./web/src/components/agt-console-line.js"],
      "*/src/components/agt-console-line.js": ["./web/src/components/agt-console-line.js"]
    }
  },
  "include": [
    "web/src/**/*",
    "web/test/**/*",
    "web/types/**/*"
  ],
  "exclude": [
    "web/generated",
    "target",
    "node_modules",
    ".tmp"
  ]
}
